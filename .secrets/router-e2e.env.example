# Copy this file to .secrets/router-e2e.env and replace every placeholder.
# This file is safe to commit; router-e2e.env is ignored by Git.
XKEEN_ROUTER_E2E_BASE_URL=http://192.168.1.1:8088
XKEEN_ROUTER_E2E_USERNAME=admin
XKEEN_ROUTER_E2E_PASSWORD=replace-with-panel-password
XKEEN_ROUTER_SSH_HOST=192.168.1.1
XKEEN_ROUTER_SSH_PORT=222
XKEEN_ROUTER_SSH_PASSWORD=replace-with-router-password

# A human must deliberately set this to 1 before the destructive core-install
# scenario is available. Keep it at 0 for normal panel smoke runs.
XKEEN_ROUTER_E2E_ALLOW_DESTRUCTIVE=0

# Human-readable proof that this device is a disposable lab router, never a
# production router. Required by the destructive scenario.
XKEEN_ROUTER_E2E_STAND_NAME=replace-with-lab-router-name
